# MakitiPlus — Environment Variables
# Copy this file to .env and fill in your values
#
# ⚠️ SECURITY: .env files must NEVER be committed to Git.
# If a key was ever exposed, rotate it immediately in the Supabase dashboard.
# See: https://supabase.com/docs/guides/api/api-keys#securing-your-api-keys

# ─── Frontend (VITE_ prefix → embedded in build) ───────────

# Supabase
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_DASHBOARD_URL=""

# Stripe — leave empty to disable payments (plans default to free/starter)
VITE_STRIPE_PUBLISHABLE_KEY=""

# Sentry — leave empty to disable monitoring
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="production"
VITE_SENTRY_TRACES_SAMPLE_RATE="0.1"
VITE_SENTRY_REPLAY_SAMPLE_RATE="0.05"

# App version — used by Sentry for release tracking
# Set from CI: VITE_APP_VERSION=$(git describe --tags --always)
VITE_APP_VERSION=""

# Demo mode — set to "true" ONLY for demo/test deployments
# ⚠️ NEVER set to "true" in production — it blocks all mutations
VITE_DEMO_MODE="false"

# ═══════════════════════════════════════════════════════════
# Edge Function env vars (set in Supabase Dashboard → Edge Functions → Secrets)
# These are NOT prefixed with VITE_ because they are server-side only.
# ═══════════════════════════════════════════════════════════

# ─── Stripe (required for payments) ────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe price IDs — MUST match the names used in stripeApi.ts
# Monthly prices (required for checkout to work)
STRIPE_PRICE_ID_CROISSANCE_MONTHLY="price_..."
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY="price_..."
# Yearly prices (optional — if unset, yearly checkout falls back to monthly)
STRIPE_PRICE_ID_CROISSANCE_YEARLY=""
STRIPE_PRICE_ID_ENTERPRISE_YEARLY=""

# Legacy aliases (still supported by stripeApi.ts as fallback)
# STRIPE_PRICE_ID_CROISSANCE="price_..."
# STRIPE_PRICE_ID_ENTERPRISE="price_..."

# ─── CORS (required for edge functions) ────────────────────
CORS_ORIGIN="https://makitiplus.onrender.com"

# ─── Cron (required for scheduled edge functions) ─────────
CRON_SECRET="generate-a-random-secret-here"

# ─── App URL (used for email links, redirects) ─────────────
APP_URL="https://makitiplus.onrender.com"

# ─── AI Assistant (required for the ai-assistant-chat edge function) ──
# Groq (primary — fast, low-cost, used by ai-assistant-chat)
GROQ_API_KEY="gsk_..."
# OpenRouter (reserved for future use — not wired into any function yet)
OPENROUTER_API_KEY="sk-or-v1-..."

# ─── Resend (optional — transactional emails) ──────────────
RESEND_API_KEY=""

# ─── Twilio (optional — SMS password reset) ────────────────
LOVABLE_API_KEY=""
TWILIO_API_KEY=""
TWILIO_FROM_NUMBER=""

# ─── Auto-provisioned by Supabase (do NOT set manually) ───
# SUPABASE_URL — automatically set by Supabase
# SUPABASE_SERVICE_ROLE_KEY — automatically set by Supabase
# SUPABASE_PUBLISHABLE_KEY — automatically set by Supabase

# ═══════════════════════════════════════════════════════════
# E2E tests (Playwright) — local/CI only, never set in production
# ═══════════════════════════════════════════════════════════

# ⚠️ PILOTE RÉEL "Diallo & Frères" — voir docs/production/DIALLO_FRERES_PILOT_RUNBOOK.md
# E2E_TEST_EMAIL / E2E_TEST_PASSWORD (e2e/pilot-critical.spec.ts) sont les seuls identifiants
# autorisés à pointer sur le magasin pilote réel, et UNIQUEMENT pour des scénarios en lecture
# seule (navigation, affichage). Ne jamais réutiliser ces identifiants comme E2E_ADMIN_EMAIL/
# E2E_SUPER_ADMIN_EMAIL ci-dessous : ces derniers sont utilisés par des scénarios qui créent des
# données (produit, vente) ou en suppriment (organisation) et NE DOIVENT JAMAIS cibler Diallo & Frères.
E2E_TEST_EMAIL=""
E2E_TEST_PASSWORD=""

# Garde-fou anti-pilote (src/lib/pilotProtection.ts) — voir aussi src/test/pilotDataProtection.test.ts
# E2E_PROTECT_PILOT_STORE : documente que la protection est active (le garde-fou lui-même est
# toujours actif dans le code, il ne peut pas être désactivé par variable d'environnement).
E2E_PROTECT_PILOT_STORE="true"
E2E_PILOT_ORG_NAME="Diallo & Frères"
# Doit rester "false" partout sauf dans un run CI dédié ciblant explicitly E2E_TEST_ORG/TEST_STORE/STAGING/DEMO_ORG
E2E_ALLOW_DESTRUCTIVE="false"

# Identifiants pour les scénarios mutants/destructifs (e2e/staging-real-flow.spec.ts) —
# DOIVENT pointer sur un compte STAGING/DEMO_ORG jetable, jamais sur Diallo & Frères
E2E_BASE_URL=""
E2E_SUPER_ADMIN_EMAIL=""
E2E_SUPER_ADMIN_PASSWORD=""
E2E_ADMIN_EMAIL=""
E2E_ADMIN_PASSWORD=""
E2E_VENDOR_EMAIL=""
E2E_VENDOR_PASSWORD=""
E2E_MANAGER_EMAIL=""
E2E_MANAGER_PASSWORD=""
# Nom de l'organisation de test jetable (jamais "Diallo & Frères")
E2E_TEST_ORG_NAME=""
# Nom du magasin de test jetable rattaché à E2E_TEST_ORG_NAME
E2E_TEST_STORE_NAME=""
